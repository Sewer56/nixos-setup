#!/usr/bin/env bash
# pre-commit: block committing a submodule bump without a matching flake.lock
# bump. Prevents the "NAR hash mismatch" build failure at the source, and — for
# the secrets submodule — the subtler failure where the pointer moves but the
# build silently keeps using the old secret values.
#
# Invariant enforced, for each pair below:
#   staged submodule pointer MUST equal flake.lock's pinned rev for the
#   corresponding flake input.
#
# Activated by `core.hooksPath = hooks`. Runs in any repo that has a `hooks/`
# dir; silently skips when neither submodule is staged, so it's harmless on
# other repositories.
#
# If you hit this hook: run, then re-stage and re-commit:
#   nix flake update <input> && git add flake.lock

set -euo pipefail

# submodule path : flake input name
PAIRS=(
  "users/sewer/home-manager/programs/opencode:opencode-config"
  "users/sewer/secrets:nixos-secrets"
)

# Read a locked rev out of flake.lock. Prefers the staged copy, falls back to
# the working tree when flake.lock isn't staged.
lock_rev() {
  local input="$1"
  local prog="import json,sys; print(json.load(sys.stdin)['nodes']['$input']['locked']['rev'])"
  if git diff --cached --name-only -- flake.lock | grep -q .; then
    git show :flake.lock 2>/dev/null | python3 -c "$prog" 2>/dev/null || true
  else
    python3 -c "$prog" < flake.lock 2>/dev/null || true
  fi
}

status=0

for pair in "${PAIRS[@]}"; do
  submod="${pair%%:*}"
  input="${pair##*:}"

  # Submodule pointer staged for commit? If not, nothing to check.
  staged=$(git ls-files -s -- "$submod" 2>/dev/null | awk '{print $2}')
  [ -z "$staged" ] && continue

  # Did the submodule pointer actually change vs HEAD? If not, skip.
  head_rev=$(git ls-tree HEAD -- "$submod" 2>/dev/null | awk '{print $3}')
  [ "$staged" = "$head_rev" ] && continue

  # Submodule is being bumped → flake.lock MUST be staged with matching rev.
  locked=$(lock_rev "$input")
  short="${locked:0:12}"; short="${short:-MISSING}"

  if [ -z "$locked" ] || [ "$staged" != "$locked" ]; then
    echo "ERROR: $submod bumped to ${staged:0:12} but flake.lock pins $input at $short." >&2
    echo "Submodule rev and flake.lock rev must match, or the build uses the wrong revision." >&2
    echo "Fix:" >&2
    echo "  nix flake update $input && git add flake.lock" >&2
    status=1
  fi
done

exit "$status"
